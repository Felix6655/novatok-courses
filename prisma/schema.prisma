// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String
  icon         String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses Course[]

  @@index([active, displayOrder])
}

model Course {
  id                   String       @id @default(uuid())
  title                String
  slug                 String       @unique
  shortDescription     String
  fullDescription      String
  categoryId           String
  instructorName       String
  instructorBio        String
  thumbnailUrl         String
  promoVideoUrl        String?
  price                Decimal      @db.Decimal(10, 2)
  originalPrice        Decimal?     @db.Decimal(10, 2)
  currency             String       @default("USD")
  level                CourseLevel
  language             String       @default("en")
  durationMinutes      Int
  lessonCount          Int
  certificateAvailable Boolean      @default(false)
  prerequisites        String[]     @default([])
  learningOutcomes     String[]     @default([])
  enrollmentUrl        String
  status               CourseStatus @default(DRAFT)
  featured             Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  category         Category            @relation(fields: [categoryId], references: [id])
  modules          CourseModule[]
  lessons          Lesson[]
  enrollments      StudentEnrollment[]
  progress         LessonProgress[]
  activities       LearningActivity[]
  practiceSessions PracticeSession[]
  translations     CourseTranslation[]

  @@index([status, categoryId])
  @@index([status, featured])
  @@index([status, level])
  @@index([status, price])
  @@index([categoryId])
}

/// A unit of course structure grouping ordered Lessons. Sprint 3 content
/// foundation for the AI Tutor â€” not a full LMS authoring model.
model CourseModule {
  id           String   @id @default(uuid())
  courseId     String
  title        String
  description  String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id])
  lessons      Lesson[]
  translations CourseModuleTranslation[]

  @@unique([courseId, displayOrder])
  @@index([courseId])
}

/// Real learning content the AI Tutor grounds its answers in. `courseId`
/// is denormalized from the parent module so retrieval can query "all
/// lessons for this course" directly without a join.
model Lesson {
  id           String   @id @default(uuid())
  moduleId     String
  courseId     String
  slug         String
  title        String
  summary      String
  content      String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  module CourseModule @relation(fields: [moduleId], references: [id])
  course Course       @relation(fields: [courseId], references: [id])

  progress              LessonProgress[]
  currentForEnrollments StudentEnrollment[]
  activities            LearningActivity[]
  practiceSessions      PracticeSession[]
  translations          LessonTranslation[]

  @@unique([courseId, slug])
  @@unique([moduleId, displayOrder])
  @@index([moduleId])
  @@index([courseId])
}

/**
 * A student's enrollment in a course. `studentId` is an opaque identifier
 * from the identity boundary (src/server/identity/) â€” Sprint 5 uses a
 * development-only identity, not real authentication. See
 * docs/student-identity.md for how this connects to real NovaTok Social
 * user IDs later without changing this model.
 */
model StudentEnrollment {
  id              String   @id @default(uuid())
  studentId       String
  courseId        String
  currentLessonId String?
  enrolledAt      DateTime @default(now())
  lastAccessedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentLesson Lesson? @relation(fields: [currentLessonId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

enum LearningActivityType {
  LESSON_STARTED
  LESSON_COMPLETED
  TUTOR_QUESTION
  PRACTICE_ATTEMPT
  COACH_REQUEST
}

/**
 * A bounded, structured record of learning-relevant events â€” the raw
 * material for Sprint 6's deterministic learning signals (see
 * src/server/learning/learning-signals.ts). Deliberately NOT a UI click
 * log: only the five event types above are ever written. `metadata` is a
 * small, fixed-shape JSON object per type (e.g. { correct, questionType }
 * for PRACTICE_ATTEMPT) â€” never raw AI prompts, answers, or unrestricted
 * conversation text. See docs/learning-progress.md.
 */
model LearningActivity {
  id        String               @id @default(uuid())
  studentId String
  courseId  String
  lessonId  String?
  type      LearningActivityType
  metadata  Json?
  createdAt DateTime             @default(now())

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([studentId, courseId])
  @@index([studentId, lessonId])
  @@index([courseId, type])
}

enum PracticeQuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

/**
 * Sprint 7: the PostgreSQL-backed replacement for Sprint 6's in-memory
 * practice-store.ts. Holds a generated practice question's answer key
 * server-side between generation and evaluation â€” never exposed through
 * the generate API. One-shot: `consumedAt` is set atomically (via a
 * `WHERE consumedAt IS NULL` conditional update, not a read-then-write)
 * the moment a student's answer is evaluated, so a concurrent replay of
 * the same practiceId cannot double-consume it. `expiresAt` bounds how
 * long an unanswered question stays valid. Only the minimum state needed
 * to grade one attempt is stored â€” no prompt/conversation history.
 */
model PracticeSession {
  id                 String               @id @default(uuid())
  studentId          String
  courseId           String
  lessonId           String
  questionType       PracticeQuestionType
  question           String
  choices            String[]             @default([])
  correctChoiceIndex Int?
  modelAnswer        String?
  explanation        String
  createdAt          DateTime             @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([expiresAt])
}

/**
 * One row per (student, lesson): whether and when it was started and
 * completed. `courseId` is denormalized from the lesson (same pattern as
 * Lesson.courseId) so "all of this student's progress in this course" is
 * a direct query, not a join through Lesson.
 */
model LessonProgress {
  id          String    @id @default(uuid())
  studentId   String
  courseId    String
  lessonId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, courseId])
  @@index([lessonId])
}

enum TranslationStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

model CourseTranslation {
  id               String @id @default(uuid())
  courseId         String
  locale           String
  title            String
  shortDescription String
  fullDescription  String
  prerequisites    String[] @default([])
  learningOutcomes String[] @default([])
  status           TranslationStatus @default(DRAFT)
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([courseId, locale])
  @@index([locale, title])
  @@index([locale, status])
}

model CourseModuleTranslation {
  id          String @id @default(uuid())
  moduleId    String
  locale      String
  title       String
  description String
  status      TranslationStatus @default(DRAFT)
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([moduleId, locale])
  @@index([locale])
  @@index([locale, status])
}

model LessonTranslation {
  id       String @id @default(uuid())
  lessonId String
  locale   String
  title    String
  summary  String
  content  String
  status   TranslationStatus @default(DRAFT)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([lessonId, locale])
  @@index([locale, title])
  @@index([locale, status])
}