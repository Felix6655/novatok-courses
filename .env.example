# Copy this file to .env and fill in real values for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novatok_courses?schema=public"
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Local isolated development. Production requires "novatok-social".
STUDENT_IDENTITY_MODE="development"
# NOVATOK_SOCIAL_ORIGIN="https://novatoksocial.com"
# NOVATOK_SOCIAL_CLIENT_ID="novatok-courses"
# NOVATOK_SOCIAL_CLIENT_SECRET="replace-with-at-least-32-random-characters"
# NOVATOK_COURSES_ORIGIN="http://localhost:3001"
# NOVATOK_COURSES_SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional model-routing configuration. Specs contain provider/model names only,
# never credentials. Route precedence is task.locale, locale, task, default.
# AI_MODEL_ROUTES_JSON=
# Value is JSON with default, routes, and fallbacks keys; see
# docs/ai-model-routing.md for a safe example.
# Optional longer Ollama request window for large, cold-loading local models:
# OLLAMA_TIMEOUT_MS=100000
# Optional OpenAI-compatible OmniRoute endpoint and API key. Local OmniRoute
# can run without a key; never commit a real key here.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=

# Optional comma-separated additional trusted browser origins for CSRF.
# NOVATOK_ALLOWED_ORIGINS="https://novatoksocial.com"
# Optional real two-user authenticated smoke credentials (never commit values):
# NOVATOK_AUTH_TEST_EMAIL=
# NOVATOK_AUTH_TEST_PASSWORD=
# NOVATOK_AUTH_TEST_EMAIL_2=
# NOVATOK_AUTH_TEST_PASSWORD_2=
# AUTH_SMOKE_COURSES_ORIGIN=http://localhost:3000
