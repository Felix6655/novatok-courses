# Copy this file to .env and fill in real values for local development.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novatok_courses?schema=public"

# AI Course Advisor — see docs/ai-course-advisor.md
# No API key needed for the local Ollama provider; nothing below is a secret.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
