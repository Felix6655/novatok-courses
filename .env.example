# Copy this file to .env and fill in real values for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novatok_courses?schema=public"
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Local isolated development. Production requires "novatok-social".
STUDENT_IDENTITY_MODE="development"
# NOVATOK_SOCIAL_ORIGIN="https://novatoksocial.com"
# Optional comma-separated additional trusted browser origins for CSRF.
# NOVATOK_ALLOWED_ORIGINS="https://novatoksocial.com"
# Optional real two-user authenticated smoke credentials (never commit values):
# NOVATOK_AUTH_TEST_EMAIL=
# NOVATOK_AUTH_TEST_PASSWORD=
# NOVATOK_AUTH_TEST_EMAIL_2=
# NOVATOK_AUTH_TEST_PASSWORD_2=
# AUTH_SMOKE_COURSES_ORIGIN=http://localhost:3000
