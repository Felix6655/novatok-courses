# Copy this file to .env and fill in real values for local development.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novatok_courses?schema=public"

# AI Course Advisor — see docs/ai-course-advisor.md
# No API key needed for the local Ollama provider; nothing below is a secret.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Student identity — see docs/student-identity.md and docs/production-hardening.md.
# Only required when NODE_ENV=production. There is no production identity
# adapter yet, so a production deployment must explicitly opt into the
# development-only cookie identity by setting this to "development" — any
# other value (or leaving it unset) makes the app refuse to resolve a
# student identity in production, rather than silently using it.
# STUDENT_IDENTITY_MODE="development"
